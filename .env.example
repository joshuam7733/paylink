# Copy to .env and adjust. Never commit .env.

# Database. SQLite file for local development (path is relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Public base URL used to build payment links and password reset links.
APP_URL="http://localhost:3000"

# Payment mode. Phase 1 supports only "demo": every payment is simulated and no provider is called.
PAYMENTS_MODE="demo"

# Session lifetime in days.
SESSION_TTL_DAYS="7"

# Seed: the administrator account created by `npm run db:seed`.
# Change the password before sharing a deployment with anyone.
SEED_ADMIN_EMAIL="admin@paylink.test"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-2026"

# Show /dev/outbox (stored emails) outside development. Leave "false" in any shared deployment.
ENABLE_DEV_OUTBOX="false"
