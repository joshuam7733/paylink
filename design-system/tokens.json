{
  "$description": "Paylink design tokens v0.2. Mirrors tokens.css. Light theme is default; dark overrides under 'dark'.",
  "color": {
    "brand": { "navy": "#142B45", "emerald": "#10A88A", "cloud": "#F7F9FC" },
    "support": {
      "navy950": "#0B1726", "navy900": "#0F2138", "navy700": "#233D5C",
      "slate600": "#4A5F78", "slate500": "#5B6E85", "slate300": "#B4C2D3",
      "line": "#DCE3EC", "lineSoft": "#E8EDF3", "sunken": "#EEF2F7", "white": "#FFFFFF",
      "emerald50": "#E7F6F2", "emerald100": "#C8EDE3", "emerald700": "#08745F",
      "danger": "#B23A33", "dangerBg": "#FCEDEC",
      "warning": "#9A5B00", "warningBg": "#FFF4E0",
      "info": "#2B5C8A", "infoBg": "#EAF1F8"
    },
    "role": {
      "bg": "#F7F9FC", "surface": "#FFFFFF", "surfaceSunken": "#EEF2F7",
      "text": "#142B45", "textSecondary": "#4A5F78", "textTertiary": "#5B6E85",
      "border": "#DCE3EC", "borderSoft": "#E8EDF3",
      "action": "#142B45", "actionHover": "#0F2138", "actionPressed": "#0B1726", "onAction": "#10A88A",
      "actionInverse": "#10A88A", "actionInverseHover": "#1FB596", "onActionInverse": "#142B45", "accent": "#10A88A",
      "link": "#08745F", "strongSurface": "#142B45", "onStrong": "#F7F9FC",
      "focusRing": "rgba(16,168,138,0.40)"
    },
    "status": {
      "PENDING":            { "label": "Awaiting payment",  "fg": "#2B5C8A", "bg": "#EAF1F8", "icon": "dot" },
      "FUNDS_SECURED_DEMO": { "label": "Payment secured", "fg": "#08745F", "bg": "#E7F6F2", "icon": "lock" },
      "COMPLETED":          { "label": "Completed",         "fg": "#142B45", "bg": "#10A88A", "icon": "check" },
      "PAYMENT_FAILED":     { "label": "Payment failed",    "fg": "#B23A33", "bg": "#FCEDEC", "icon": "x" },
      "CANCELLED":          { "label": "Cancelled",         "fg": "#4A5F78", "bg": "#EEF2F7", "icon": "dot" },
      "$note": "Demo mode is shown at account level, not per status. See color.demo."
    },
    "demo": { "fg": "#9A5B00", "bg": "#FFF4E0", "border": "#F1DDB8" },
    "dark": {
      "action": "#10A88A", "onAction": "#142B45",
      "bg": "#0B1726", "surface": "#0F2138", "surfaceSunken": "#0A1422",
      "text": "#F7F9FC", "textSecondary": "#B4C2D3", "textTertiary": "#93A4B8",
      "border": "#22395A", "borderSoft": "#1A2F4B", "link": "#3CC9AA"
    }
  },
  "font": {
    "display": "'Bricolage Grotesque', 'Instrument Sans', ui-sans-serif, system-ui, sans-serif",
    "body": "'Instrument Sans', ui-sans-serif, system-ui, 'Segoe UI', Roboto, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, Consolas, monospace"
  },
  "type": {
    "display": { "size": [40, 56], "lineHeight": 1.05, "weight": 650, "tracking": "-0.03em", "font": "display" },
    "h1": { "size": [32, 40], "lineHeight": 1.12, "weight": 650, "tracking": "-0.025em", "font": "display" },
    "h2": { "size": [24, 28], "lineHeight": 1.2, "weight": 650, "tracking": "-0.02em", "font": "display" },
    "h3": { "size": 20, "lineHeight": 1.3, "weight": 600, "tracking": "-0.015em", "font": "display" },
    "h4": { "size": 17, "lineHeight": 1.4, "weight": 600, "font": "body" },
    "bodyLg": { "size": 17, "lineHeight": 1.55, "weight": 400, "font": "body" },
    "body": { "size": 15, "lineHeight": 1.5, "weight": 400, "font": "body" },
    "input": { "size": 16, "weight": 400, "font": "body" },
    "sm": { "size": 13, "lineHeight": 1.4, "weight": 400, "font": "body" },
    "label": { "size": 13, "lineHeight": 1.4, "weight": 600, "font": "body" },
    "overline": { "size": 11, "weight": 600, "tracking": "0.08em", "transform": "uppercase", "font": "body" }
  },
  "space": { "0": 0, "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
  "radius": { "xs": 4, "sm": 8, "md": 10, "lg": 14, "xl": 20, "full": 999 },
  "shadow": {
    "xs": "0 1px 2px rgba(20,43,69,0.06)",
    "sm": "0 2px 6px -1px rgba(20,43,69,0.08), 0 1px 2px rgba(20,43,69,0.05)",
    "md": "0 8px 24px -8px rgba(20,43,69,0.16), 0 2px 6px -2px rgba(20,43,69,0.06)",
    "lg": "0 24px 48px -16px rgba(20,43,69,0.24)"
  },
  "motion": {
    "duration": { "instant": 80, "fast": 140, "base": 220, "slow": 360, "status": 600 },
    "easing": { "out": [0.22, 1, 0.36, 1], "inOut": [0.65, 0, 0.35, 1], "in": [0.55, 0, 1, 0.45] },
    "spring": { "type": "spring", "stiffness": 420, "damping": 34, "mass": 0.9 },
    "reducedMotion": "all durations 0; slides become instant swaps; shimmer off"
  },
  "layout": {
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "containerMax": 1200, "contentMax": 680, "checkoutMax": 560, "sidebarWidth": 248, "tapMin": 44,
    "gutter": { "phone": 16, "tablet": 24, "desktop": 32 }
  }
}
